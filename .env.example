# Copy this file to .env and use it as-is to get running immediately.
# The JWT_SECRET_KEY and FIELD_ENCRYPTION_KEY below are REAL, VALID keys —
# not placeholders — generated specifically for this repo so a plain
# `cp .env.example .env` boots the stack with zero edits. They are public
# (committed to the repo), so they are fine for local dev / hackathon
# judging on a machine that isn't internet-facing, but MUST be regenerated
# before any real deployment — see the command above each one. Never
# commit your real .env once you've regenerated them.

# --- App ---
APP_NAME=SOCMINT
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql://socmint:socmint@postgres:5432/socmint

# --- JWT ---
# Regenerate for real use: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
JWT_SECRET_KEY=KHv35pq/GIK8AI4opzBKrLSnnFDG/5eaMFZQF3yYJLo=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Field-level AES-256-GCM encryption key (32 bytes, base64) ---
# Regenerate the same way as JWT_SECRET_KEY, using a DIFFERENT random value.
# If you change this after any accounts exist, their encrypted PII fields
# (name/organisation/phone) become permanently undecryptable — regenerate
# BEFORE first sign-up, not after.
FIELD_ENCRYPTION_KEY=4fdwWAl2UBLvSKIpG10R6dS6ctcN4QE6aMj0zThjRTs=

# --- MFA ---
MFA_ISSUER_NAME=SOCMINT

# --- Rate limiting ---
MAX_FAILED_LOGINS_BEFORE_FLAG=5

# --- Default admin account, seeded automatically on first boot if no ---
# --- admin exists yet. Sign in with these, then change the passcode   ---
# --- immediately (Settings page). See README "Default admin login".  ---
DEFAULT_ADMIN_EMAIL=admin@socmint-demo.com
DEFAULT_ADMIN_PASSCODE=ChangeMe#2026!

# --- Telegram (telethon) ---
TELEGRAM_API_ID=12621892
TELEGRAM_API_HASH=ddfe40d34f578488102d37d49cb48aec
TELEGRAM_SESSION_NAME=socmint_ingest
# Comma-separated public channel usernames. Edit freely — relevant
# communities shift over time, so this is config, not code.
TELEGRAM_SEED_CHANNELS=

# --- Reddit (praw) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=socmint-ingest/0.1
REDDIT_SEED_SUBREDDITS=india,IndiaSpeaks,indianews

# --- X (Twitter) ---
X_BEARER_TOKEN=

# --- Email (password reset). If left blank, reset links are logged to ---
# --- the backend console instead of emailed — fine for local dev, not ---
# --- for anything real. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@socmint.local
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Base URL the frontend is served from, used to build the reset link.
FRONTEND_BASE_URL=https://localhost

# --- Frontend ---
VITE_API_BASE_URL=/api
